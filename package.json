{
  "name": "codeforge",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "predev": "if exist .backend_port del .backend_port",
    "dev": "concurrently \"npm run dev --workspace backend\" \"npm run dev:frontend:wait\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:frontend:wait": "powershell -ExecutionPolicy Bypass -File ./wait-for-backend.ps1",
    "build": "npm run build --workspace frontend",
    "start": "concurrently \"npm run start --workspace backend\" \"npm run start --workspace frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wait-on": "^9.0.4"
  }
}
